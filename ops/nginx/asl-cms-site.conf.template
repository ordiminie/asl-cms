# Site d'une association servie par ASL-CMS (ADR 036, s12b).
# Gabarit : ops/add-domain.sh remplace __DOMAIN__ et ecrit
# /etc/nginx/sites-available/asl-cms-<domaine>.conf. Ne pas editer a la main
# le fichier produit : relancer le script.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Defi ACME de certbot (--webroot) : seul chemin servi en HTTP.
    location /.well-known/acme-challenge/ {
        root /var/www/asl-cms-acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# BEGIN HTTPS
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Enveloppe applicative de 16 Mo (ADR 026), plus la marge du multipart.
    client_max_body_size 17m;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;

        # Ecrases, jamais completes : l'application resout le tenant d'apres
        # X-Forwarded-Host et l'adresse du visiteur d'apres X-Forwarded-For.
        # Next ne remplace pas un en-tete X-Forwarded-* deja present.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;

        # Streaming des pages (Cache Components) : pas de mise en tampon.
        proxy_buffering off;
    }
}
# END HTTPS
