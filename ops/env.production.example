# Gabarit de /srv/asl-cms/shared/.env.production (ADR 036, s12b).
#
#   sudo install -o asl-cms -g asl-cms -m 600 ops/env.production.example \
#     /srv/asl-cms/shared/.env.production
#
# puis remplir les valeurs en MAJUSCULES et les secrets vides. Ce fichier n'est
# jamais versionne une fois rempli. Les NEXT_PUBLIC_* sont figees au build :
# en changer une demande un redeploiement.
# NODE_ENV n'est pas ici : systemd et le script de deploiement le posent.

# --- Base de donnees (PostgreSQL local, docs/exploitation/README.md) ---
# Role applicatif, ni proprietaire ni BYPASSRLS (ADR 002) : pnpm db:check le verifie.
DATABASE_URL=postgres://asl_app:MOT_DE_PASSE_ASL_APP@127.0.0.1:5432/asl_cms
# Role proprietaire, pour les migrations seulement.
DATABASE_MIGRATION_URL=postgres://asl_owner:MOT_DE_PASSE_ASL_OWNER@127.0.0.1:5432/asl_cms
# Serveur long-running : docs/database-pool.md, section 6.
DATABASE_POOL_MAX=10

# --- Authentification ---
# openssl rand -base64 32 ; sert aussi de cle aux empreintes (s03, s08b).
BETTER_AUTH_SECRET=
# Protocole et port de la plateforme (ADR 022) : https, sans port. Le nom
# d'hote est remplace par le domaine de chaque association.
BETTER_AUTH_URL=https://DOMAINE_DE_LA_PREMIERE_ASSOCIATION
BETTER_AUTH_TRUSTED_ORIGINS=https://DOMAINE_DE_LA_PREMIERE_ASSOCIATION
NEXT_PUBLIC_APP_URL=https://DOMAINE_DE_LA_PREMIERE_ASSOCIATION
NEXT_PUBLIC_AUTH_METHODS=credential,magiclink
NEXT_PUBLIC_BETTER_AUTH_REQUIRE_EMAIL_VERIFICATION=true
NEXT_PUBLIC_BETTER_AUTH_2FA_ENABLE=true
NEXT_PUBLIC_BETTER_AUTH_2FA_SKIP_VERIFICATION_ON_ENABLE=true
NEXT_PUBLIC_BETTER_AUTH_TOKEN_MANAGEMENT=true
NEXT_PUBLIC_BETTER_AUTH_CHANGE_PASSWORD=true
NEXT_PUBLIC_BETTER_AUTH_CHANGE_EMAIL=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (ADR 005, ADR 017) ---
EMAIL_TRANSPORT=brevo
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_OUTBOX_DIR=
# Expediteur de la plateforme, adresse verifiee chez Brevo.
EMAIL_FROM=ADRESSE_EXPEDITEUR
EMAIL_TO=ADRESSE_EMAILS_INTERNES

# --- Fichiers (ADR 004) : dans shared/, conserves entre deux versions ---
STORAGE_TYPE=local
LOCAL_STORAGE_ROOT=/srv/asl-cms/shared/storage
NEXT_PUBLIC_MAX_FILE_SIZE=5242880
NEXT_PUBLIC_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,application/pdf

# --- Stripe (abonnement plateforme) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=CLE_PUBLIQUE_STRIPE
NEXT_PUBLIC_STRIPE_CHECKOUT_TYPE=EmbededForm
NEXT_PUBLIC_BILLING_MODE=organization
NEXT_PUBLIC_GUEST_CHECKOUT_ENABLED=false

# --- Application ---
NEXT_PUBLIC_NODE_ENV=production
# Back-office SuperAdmin (/admin).
NEXT_PUBLIC_ENABLED_PAGES=admin
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
LOG_LEVEL=info

# --- Sentry (facultatif) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
