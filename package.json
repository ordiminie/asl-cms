{
  "name": "next-saas-boilerplate",
  "description": "Next.js SaaS Boilerplate by Mike Codeur",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "tsx scripts/preflight-build.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "check:rules": "node --import tsx scripts/check-rules.ts",
    "check:rules:fix": "node --import tsx scripts/check-rules.ts --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "test": "vitest --pool=forks",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "db:check": "tsx src/db/scripts/check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/scripts/migrate.ts",
    "db:baseline": "tsx src/db/scripts/baseline-migrations.ts",
    "db:clear": "tsx src/db/scripts/clear.ts",
    "db:push": "drizzle-kit push --force",
    "db:pull": "drizzle-kit pull",
    "db:drop": "drizzle-kit drop",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/scripts/seed.ts",
    "db:reset-seed": "pnpm db:clear && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/auth/stripe/webhook",
    "stripe:logs": "stripe logs tail",
    "init:env": "tsx scripts/init-env.ts",
    "knip": "knip"
  },
